# QJ Security Check - Configuration
# ==================================
# Copy this file to config.env and fill in your values.
# DO NOT commit config.env to git (it's in .gitignore)!

# ============================================================================
# TELEGRAM NOTIFICATIONS
# ============================================================================
# To get these values:
# 1. Create a bot via @BotFather on Telegram
# 2. Get TELEGRAM_BOT_TOKEN from BotFather
# 3. Start a chat with your bot
# 4. Get TELEGRAM_CHAT_ID by visiting:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    (send a message to your bot first, then check the "chat":{"id":...})

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ============================================================================
# EMAIL NOTIFICATIONS
# ============================================================================
# Email address to receive alerts
EMAIL_TO=""

# From address (optional)
EMAIL_FROM="security-check@$(hostname)"

# SMTP server (if using external relay)
SMTP_SERVER=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ============================================================================
# ALERT THRESHOLDS
# ============================================================================
# When to send notifications
NOTIFY_ON_CRITICAL="true"   # Always notify on critical issues
NOTIFY_ON_WARNING="false"   # Also notify on warnings (can be noisy)

# Thresholds for what counts as critical
THRESHOLD_SECURITY_UPDATES=1     # >= this many security updates = CRITICAL
THRESHOLD_FAILED_SSH=100         # >= this many failed SSH = WARNING
THRESHOLD_DISK_PERCENT=90        # >= this disk usage = WARNING

# ============================================================================
# SERVERS (optional - override defaults)
# ============================================================================
# Space-separated list of servers to check
# SERVERS="sce dat api edge db res ai"

# Default SSH user (empty = root)
# SSH_USER=""

# ============================================================================
# PATHS
# ============================================================================
# Where to store reports
REPORT_DIR="./reports"

# Where to store logs
LOG_DIR="./logs"

# ============================================================================
# SCHEDULE (used by install_cron.sh)
# ============================================================================
# Cron expression for scheduled checks
# Default: every hour at minute 0
CRON_SCHEDULE="0 * * * *"

# Which script to run
CRON_COMMAND="./security_check.sh -p --notify"
